# Build läuft auf Windows, deployed wird auf einen Raspberry Pi (linux/arm64) —
# native Optional-Deps (@libsql/client, Tailwind-Oxide, ...) für beide
# Plattformen mit herunterladen, damit der standalone-Output auch auf dem Pi läuft.
supportedArchitectures.os[]=current
supportedArchitectures.os[]=linux
supportedArchitectures.cpu[]=current
supportedArchitectures.cpu[]=arm64
supportedArchitectures.libc[]=glibc
