DATABASE_URL=file:./data/vortex.db

# Ziel-Gerät für Wake-on-LAN und Ping (z.B. der Gaming-PC)
DEVICE_MAC=00:00:00:00:00:00
DEVICE_IP=192.168.1.10
DEVICE_BROADCAST=192.168.1.255

# Einfacher Bearer-Token-Schutz für die API-Routes.
# Beide Werte müssen identisch sein: API_TOKEN wird serverseitig geprüft,
# NEXT_PUBLIC_API_TOKEN wird vom Dashboard selbst zum Aufruf mitgeschickt.
API_TOKEN=change-me
NEXT_PUBLIC_API_TOKEN=change-me
